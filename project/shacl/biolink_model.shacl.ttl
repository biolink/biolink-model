	sh:order 20 ;
	sh:path dct:description .
_:c14n7400 sh:description "Should be the highest level of FDA approval this chemical entity or device has, regardless of which disease, condition or phenotype it is currently being reviewed to treat.  For specific levels of FDA approval for a specific condition, disease, phenotype, etc., see the association slot, 'clinical approval status.'" ;
	sh:in _:c14n21632 ;
	sh:maxCount 1 ;
	sh:order 1 ;
	sh:path biolink:highest_FDA_approval_status .
