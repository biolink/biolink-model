	sh:nodeKind sh:IRI ;
	sh:order 1 ;
	sh:path biolink:expression_site .
_:c14n8620 sh:datatype xsd:boolean ;
	sh:description "A boolean flag indicating that an entity is no longer considered current or valid." ;
