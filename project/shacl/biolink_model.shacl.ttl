_:c14n8098 sh:datatype xsd:float ;
	sh:description "A score defined by Jensen Lab Diseases that reports confidence level in an association on a scale of 1-5 stars.  It is based on different inputs for curated knowledge associations vs text-mined associations vs experimental/GWAS based associations, but adjusts/caps scores for these types of knowledge such that they are comparable on a single scale." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 1 ;
