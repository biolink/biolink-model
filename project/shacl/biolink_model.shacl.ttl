	sh:nodeKind sh:IRI ;
	sh:order 26 ;
	sh:path biolink:object_category_closure .
_:c14n8627 sh:datatype xsd:string ;
	sh:description "An alternate label that is related to the primary label but is neither exactly synonymous nor cleanly broader or narrower; useful as a lexical pointer but not for strict equivalence. Corresponds to oboInOwl:hasRelatedSynonym." ;
	sh:nodeKind sh:Literal ;
	sh:order 13 ;
	sh:path biolink:related_synonym .
_:c14n8628 sh:description "A statement-level qualifier used with the 'associated with' predicate (or one of its subpredicates) to indicate the biological, clinical, or statistical basis of the asserted association. Use this qualifier when no more specific predicate exists to capture the intended meaning of the association." ;
	sh:in _:c14n24711 ;
	sh:maxCount 1 ;
	sh:order 57 ;
