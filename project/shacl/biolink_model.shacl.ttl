	sh:nodeKind sh:IRI ;
	sh:order 11 ;
	sh:path biolink:qualifiers .
_:c14n5972 sh:datatype xsd:date ;
	sh:description "date on which an entity was updated. This can be applied to nodes or edges" ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 39 ;
	sh:path biolink:update_date .
