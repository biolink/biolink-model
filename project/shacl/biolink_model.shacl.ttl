_:c14n11209 sh:description "Specifies the statistical metric or method used to compute the numeric value in the companion 'effect size' slot. This disambiguates the effect size value, which is otherwise uninterpretable without knowing the metric (e.g. Cohen's d vs. odds ratio vs. Pearson's r)." ;
	sh:in _:c14n19910 ;
	sh:maxCount 1 ;
	sh:order 37 ;
