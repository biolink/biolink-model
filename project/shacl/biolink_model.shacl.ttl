	sh:order 62 ;
	sh:path rdf:type .
_:c14n8622 sh:description "Composes with the core concept (+ aspect if provided) to describe a change in its direction or degree. This qualifier qualifies the object of an association (aka: statement)." ;
	sh:in _:c14n24843 ;
	sh:maxCount 1 ;
	sh:order 4 ;
	sh:path biolink:object_direction_qualifier .
