	sh:path rdf:object .
_:c14n5975 sh:description "A qualifier that composes with a core subject/object concept to define a more specific version of the subject concept, specifically using an ontology term that is not a subclass or descendant of the core concept and in the vast majority of cases, is of a different ontological namespace than the category or namespace of the subject identifier." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:IRI ;
	sh:order 70 ;
	sh:path biolink:subject_specialization_qualifier .
_:c14n5976 sh:class biolink:AnatomicalEntity ;
