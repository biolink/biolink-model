	rdfs:subClassOf linkml:EnumDefinition ;
	owl:unionOf _:c14n2490 ;
	skos:definition "An enumeration of logical interpretations that can be applied to a triple to indicate whether the relation should be read as existential on both sides (some-some), universal-existential (all-some), or its inverse (inverse all-some)." ;
