	skos:inScheme biolink: .
biolink:ChemicalOrDrugOrTreatmentAdverseEventAssociation a owl:Class ;
	rdfs:label "chemical or drug or treatment adverse event association" ;
	rdfs:subClassOf biolink:Association , _:c14n1125 , _:c14n1169 , _:c14n1385 , _:c14n1597 , _:c14n1648 , _:c14n1874 , _:c14n2341 ;
	skos:definition "This association defines a relationship between a chemical or treatment (or procedure) and a disease or phenotypic feature where the disease or phenotypic feature is an untoward medical occurrence that happens during treatment, whether or not considered related to the treatment." ;
	skos:inScheme biolink: .
biolink:ChemicalOrDrugOrTreatmentSideEffectAssociation a owl:Class ;
	rdfs:label "chemical or drug or treatment side effect association" ;
	rdfs:subClassOf biolink:Association , _:c14n1401 , _:c14n2368 , _:c14n699 , _:c14n844 ;
	skos:definition "This association defines a relationship between a chemical or treatment (or procedure) and a disease or phenotypic feature where the disease or phenotypic feature is an unintended, but predictable, secondary effect of the treatment." ;
	skos:inScheme biolink: .
biolink:ChemicalOrDrugOrTreatmentToDiseaseOrPhenotypicFeatureAssociation a owl:Class ;
	rdfs:label "chemical or drug or treatment to disease or phenotypic feature association" ;
	rdfs:subClassOf biolink:Association , _:c14n1332 , _:c14n2381 , _:c14n2391 , _:c14n2457 , _:c14n43 , _:c14n615 , _:c14n639 ;
