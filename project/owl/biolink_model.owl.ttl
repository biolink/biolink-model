	rdfs:domain biolink:Occurrent ;
	rdfs:label "temporally related to" ;
	rdfs:range biolink:Occurrent ;
	rdfs:subPropertyOf biolink:related_to_at_instance_level ;
	skos:definition "holds between two entities with a temporal relationship" ;
	skos:exactMatch <http://purl.obolibrary.org/obo/SNOMED_temporally_related_to> ;
	skos:inScheme biolink: ;
	skos:narrowMatch RO:0002082 , RO:0002083 , RO:0002092 , RO:0002093 , RO:0002223 , RO:0002224 , RO:0002229 , RO:0002230 , RO:0002488 , RO:0002489 , RO:0002492 , RO:0002493 , RO:0002496 , RO:0002497 ;
	biolink:canonical_predicate true .
