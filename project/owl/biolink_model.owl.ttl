	skos:inScheme biolink: .
biolink:OrganismalEntity a owl:Class ;
	rdfs:label "organismal entity" ;
	rdfs:subClassOf biolink:BiologicalEntity , _:c14n1511 , _:c14n1847 , _:c14n2504 , _:c14n2737 ;
