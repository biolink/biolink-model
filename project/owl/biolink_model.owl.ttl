biolink:NamedThingAssociatedWithLikelihoodOfNamedThingAssociation a owl:Class ;
	rdfs:label "named thing associated with likelihood of named thing association" ;
	rdfs:subClassOf biolink:Association , _:c14n1025 , _:c14n1303 , _:c14n1445 , _:c14n1593 , _:c14n1609 , _:c14n1650 , _:c14n1667 , _:c14n17 , _:c14n1956 , _:c14n2172 , _:c14n2357 , _:c14n2379 , _:c14n245 , _:c14n2724 , _:c14n2743 , _:c14n319 , _:c14n543 , _:c14n815 , _:c14n85 , _:c14n884 , _:c14n904 , _:c14n959 , _:c14n982 , _:c14n989 ;
