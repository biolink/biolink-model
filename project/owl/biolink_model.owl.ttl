biolink:ResourceRoleEnum a owl:Class ;
	rdfs:label "ResourceRoleEnum" ;
	rdfs:subClassOf linkml:EnumDefinition ;
	owl:unionOf _:c14n2725 ;
	skos:definition "The role played by the information reource in serving as a source for an edge in a TRAPI message. Note that a given Edge should have one and only one 'primary' source, and may have any number of 'aggregator' or 'supporting data' sources.  This enumeration is found in Biolink Model, but is repeated here for convenience." ;
	skos:inScheme biolink: ;
	linkml:permissible_values biolink:ResourceRoleEnum\#aggregator_knowledge_source , biolink:ResourceRoleEnum\#primary_knowledge_source , biolink:ResourceRoleEnum\#supporting_data_source .
