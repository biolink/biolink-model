biolink:AssociationBasisEnum\#functional a owl:Class ;
	rdfs:label "functional" ;
	rdfs:subClassOf biolink:AssociationBasisEnum , linkml:PermissibleValue ;
	skos:definition "An association based on the participation of two biological entities in a common biological function, process, pathway, reaction, molecular complex, interaction, gene expression program, or other functional system. Functionally associated entities need not interact directly or contribute in the same direction to the shared function; they are related by their involvement in the same biological phenomenon." .
biolink:AssociationBasisEnum\#genetic a owl:Class ;
	rdfs:label "genetic" ;
	rdfs:subClassOf biolink:AssociationBasisEnum , linkml:PermissibleValue ;
	skos:definition "An association based on the relationship of two biological entities through inherited genetic variation. Examples include associations between genetic variants and phenotypes, diseases, traits, gene expression levels, protein abundance, or other molecular or organismal phenotypes. Such associations do not necessarily imply causation or direct biological function and are typically identified through genetic association studies, including genome-wide association studies (GWAS), phenome-wide association studies (PheWAS), and quantitative trait locus (QTL) mapping (e.g., eQTL and pQTL analyses)." .
biolink:AssociationBasisEnum\#statistical a owl:Class ;
	rdfs:label "statistical" ;
	rdfs:subClassOf biolink:AssociationBasisEnum , linkml:PermissibleValue ;
	skos:definition "An association based on statistical dependence (i.e., non-independence), derived from analysis of observational or experimental data using an appropriate statistical method." .
biolink:AssociationBasisEnum a owl:Class ;
	rdfs:label "AssociationBasisEnum" ;
	rdfs:subClassOf linkml:EnumDefinition ;
	owl:unionOf _:c14n2378 ;
	skos:definition "Permissible values for the 'association basis qualifier', indicating the nature or basis of an association asserted using the 'associated with' predicate or one of its subpredicates." ;
	skos:inScheme biolink: ;
	linkml:permissible_values biolink:AssociationBasisEnum\#functional , biolink:AssociationBasisEnum\#genetic , biolink:AssociationBasisEnum\#statistical .
