	skos:altLabel "detrimental for condition" , "exacerbates" ;
	skos:broadMatch SEMMEDDB:COMPLICATES ;
	skos:definition "Holds between a substance, procedure, or activity and an existing medical condition (disease or phenotypic\n feature) where the substance, procedure, or activity worsens some or all aspects of the condition." ;
