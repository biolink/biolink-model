	rdfs:subClassOf biolink:BiologicalProcess , _:c14n2406 , _:c14n634 ;
	skos:definition "The internally coordinated responses (actions or inactions) of organisms (individuals or groups) to internal or external stimuli, via a mechanism that involves nervous system activity." ;
	skos:exactMatch STY:T053 , <http://purl.obolibrary.org/obo/GO_0007610> ;
	skos:inScheme biolink: ;
	skos:narrowMatch STY:T041 , STY:T054 , STY:T055 .
