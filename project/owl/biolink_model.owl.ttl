	skos:inScheme biolink: .
biolink:Outcome a owl:Class ;
	rdfs:label "outcome" ;
	rdfs:subClassOf linkml:ClassDefinition\#Mixin ;
	skos:definition "An entity that has the role of being the consequence of an exposure event. This is an abstract mixin grouping of various categories of possible biological or non-biological outcomes." ;
	skos:inScheme biolink: .
