	rdfs:subPropertyOf biolink:statement_qualifier ;
	skos:definition "A statement qualifier representing a type of molecular control mechanism through which an effect of a chemical on a gene or gene product is mediated" ;
	skos:inScheme biolink: .
biolink:caused_by a owl:DatatypeProperty ;
	rdfs:label "caused by" ;
	rdfs:subPropertyOf biolink:contribution_from ;
	owl:inverseOf biolink:causes ;
	skos:altLabel "disease caused by disruption of" , "disease has basis in dysfunction of" , "realized in response to stimulus" , "realized in response to" ;
	skos:definition "holds between two entities where the occurrence, existence, or activity of one is caused by the occurrence or generation of the other" ;
	skos:exactMatch WIKIDATA_PROPERTY:P828 ;
	skos:inScheme biolink: ;
	skos:narrowMatch RO:0001022 , RO:0002608 , RO:0004019 , RO:0004020 , RO:0004028 , RO:0009501 .
