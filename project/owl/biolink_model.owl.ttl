	rdfs:subClassOf biolink:ReactionSideEnum , linkml:PermissibleValue .
biolink:ReactionSideEnum a owl:Class ;
	rdfs:label "ReactionSideEnum" ;
	rdfs:subClassOf linkml:EnumDefinition ;
	owl:unionOf _:c14n2581 ;
	skos:definition "An enumeration indicating on which side of a biochemical reaction a participant appears - the left-hand (reactant/substrate) side or the right-hand (product) side, as written." ;
