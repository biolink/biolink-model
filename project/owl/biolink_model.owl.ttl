biolink:ResponseTargetEnum a owl:Class ;
	rdfs:label "ResponseTargetEnum" ;
	rdfs:subClassOf linkml:EnumDefinition ;
	owl:unionOf _:c14n2306 ;
	skos:definition "The target of a treatment or intervention" ;
	skos:inScheme biolink: ;
	linkml:permissible_values biolink:ResponseTargetEnum\#cell\%20line , biolink:ResponseTargetEnum\#cohort , biolink:ResponseTargetEnum\#individual , biolink:ResponseTargetEnum\#sample .
biolink:RetrievalSource a owl:Class ;
	rdfs:label "retrieval source" ;
	rdfs:subClassOf biolink:InformationContentEntity , _:c14n1456 , _:c14n1527 , _:c14n1714 , _:c14n1722 , _:c14n1863 , _:c14n2243 , _:c14n2792 , _:c14n685 , _:c14n824 , _:c14n874 , _:c14n967 , _:c14n984 ;
	skos:definition "Provides information about how a particular InformationResource served as a source from which knowledge expressed in an Edge, or data used to generate this knowledge, was retrieved." ;
