	skos:inScheme biolink: .
biolink:StatisticalSignificanceQualifierEnum\#not_significant a owl:Class ;
	rdfs:label "not_significant" ;
	rdfs:subClassOf biolink:StatisticalSignificanceQualifierEnum , linkml:PermissibleValue ;
	skos:definition "A significance band denoting that the association does not meet the conventional threshold (significance statistic above 0.05), such that there is insufficient evidence to rule out the null hypothesis of no association." .
biolink:StatisticalSignificanceQualifierEnum\#significant a owl:Class ;
	rdfs:label "significant" ;
	rdfs:subClassOf biolink:StatisticalSignificanceQualifierEnum , linkml:PermissibleValue ;
	skos:definition "A significance band denoting that the association meets the standard conventional threshold (significance statistic at or below alpha = 0.05), such that, under the null hypothesis, an effect at least this large would be expected in no more than about one in twenty comparable studies." .
biolink:StatisticalSignificanceQualifierEnum\#strongly_significant a owl:Class ;
	rdfs:label "strongly_significant" ;
	rdfs:subClassOf biolink:StatisticalSignificanceQualifierEnum , linkml:PermissibleValue ;
	skos:definition "A significance band denoting that the association meets a stringent conventional threshold (significance statistic at or below 0.01)." .
biolink:StatisticalSignificanceQualifierEnum\#suggestive a owl:Class ;
	rdfs:label "suggestive" ;
	rdfs:subClassOf biolink:StatisticalSignificanceQualifierEnum , linkml:PermissibleValue ;
	skos:definition "A significance band denoting a borderline result (significance statistic above 0.05 but at or below roughly 0.10, sometimes extended to 0.20 in fields such as genetics) that is suggestive of, but does not conclusively support, an association." .
biolink:StatisticalSignificanceQualifierEnum\#very_strongly_significant a owl:Class ;
	rdfs:label "very_strongly_significant" ;
	rdfs:subClassOf biolink:StatisticalSignificanceQualifierEnum , linkml:PermissibleValue ;
	skos:definition "A significance band denoting that the association meets the most stringent conventional threshold (significance statistic at or below 0.001), such that, under the null hypothesis of no association, an effect at least this large would be expected in no more than about one in a thousand comparable studies." .
biolink:StatisticalSignificanceQualifierEnum a owl:Class ;
	rdfs:label "StatisticalSignificanceQualifierEnum" ;
	rdfs:subClassOf linkml:EnumDefinition ;
	owl:unionOf _:c14n172 ;
	skos:definition "An enumeration used as a qualifier to categorize the statistical significance of an association's supporting evidence into coarse bands (e.g., very strongly significant, strongly significant, significant, suggestive, not significant), conventionally anchored to alpha = 0.05. The underlying numeric value lives in the 'p value' and 'adjusted p value' slots, which remain authoritative." ;
	skos:inScheme biolink: ;
	linkml:permissible_values biolink:StatisticalSignificanceQualifierEnum\#not_significant , biolink:StatisticalSignificanceQualifierEnum\#significant , biolink:StatisticalSignificanceQualifierEnum\#strongly_significant , biolink:StatisticalSignificanceQualifierEnum\#suggestive , biolink:StatisticalSignificanceQualifierEnum\#very_strongly_significant .
