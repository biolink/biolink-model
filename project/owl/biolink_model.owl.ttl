biolink:name a owl:DatatypeProperty ;
	rdfs:domain biolink:Entity ;
	rdfs:label "name" ;
	rdfs:range xsd:string ;
	skos:altLabel "display name" , "label" , "title" ;
	skos:definition "A human-readable name for an attribute or entity." ;
