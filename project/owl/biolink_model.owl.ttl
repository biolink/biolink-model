	rdfs:subClassOf biolink:ReactionDirectionEnum , linkml:PermissibleValue .
biolink:ReactionDirectionEnum\#left_to_right a owl:Class ;
	rdfs:label "left_to_right" ;
	rdfs:subClassOf biolink:ReactionDirectionEnum , linkml:PermissibleValue .
